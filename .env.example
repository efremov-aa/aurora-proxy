# Aurora: sample env. Скопируйте в .env и заполните своими значениями.
# Секреты сюда НЕ настоящие — только примеры формата.

# Публичный/внешний адрес сервера (для vless-ссылок извне и tg://proxy).
AURORA_HOST=1.2.3.4
# Ваш "белый" IP провайдера (если есть) — для фильтра egress-проб.
AURORA_WHITE_IP=

# Админ-токен панели: Bearer для всех POST /api/*. Пусто — авторизация выключена.
# Можно задать здесь или сгенерировать кнопкой на вкладке «Безопасность» (data/admin_secret.json).
AURORA_ADMIN_TOKEN=

# Внешний VLESS-Reality inbound (опционально, :8443). Без заполнения — выключен.
AURORA_VLESS_ENABLED=false
AURORA_VLESS_PORT=8443
# Хост, который будет прописан в vless-ссылке для внешних клиентов.
AURORA_VLESS_HOST=
# UUID для внешних клиентов (например: uuidgen).
AURORA_VLESS_UUID=
# Пара X25519 ключей Reality (xray x25519).
AURORA_VLESS_PRIVATE_KEY=
AURORA_VLESS_PUBLIC_KEY=
AURORA_VLESS_SHORT_ID=
# SNI прикрытия (сервер, на который "шифруется" Reality).
AURORA_VLESS_SNI=www.microsoft.com
AURORA_VLESS_FLOW=xtls-rprx-vision

# Порт Telegram WS-прокси (по умолчанию 443; 1443 блокировался РКН снаружи).
AURORA_TGWS_PORT=443

# Управление xray: systemctl (сервер с юнитом) или proc (Docker — по умолчанию).
XRAY_MANAGE=proc
